[
  {
    "id": "life-route-food",
    "title": "把一份粮留给谁",
    "text": "你刚在灶边或田里出过力。附近有人缺一顿热食，你也得为自己和来年留粮。",
    "once": true,
    "followUpOnly": true,
    "choices": [
      {
        "id": "share",
        "label": "煮一份粟，分给邻居",
        "line": "你煮了一份粟分给邻居吃，自己少了一份储备。",
        "requires": {
          "resource": "resource:grain"
        },
        "consume": true,
        "bond": {
          "cook": {
            "trust": 1
          }
        },
        "setFlags": [
          "life-route:food:shared"
        ],
        "followUp": {
          "incident": "life-route-food-after",
          "afterDays": 3
        }
      },
      {
        "id": "keep",
        "label": "留作自己的口粮",
        "line": "你把粮留作自己的口粮，说明等有余粮再帮忙。",
        "bond": {
          "cook": {
            "familiarity": 0.3
          }
        },
        "setFlags": [
          "life-route:food:kept"
        ],
        "followUp": {
          "incident": "life-route-food-after",
          "afterDays": 3
        }
      }
    ]
  },
  {
    "id": "life-route-food-after",
    "title": "几天后的灶边",
    "text": "那天分粮的事又被提起。有人感谢你，也有人提醒，照顾别人时别忘了自己的冬粮。",
    "once": true,
    "followUpOnly": true,
    "omen": "有人捎话，说起几天前的那件事。",
    "choices": [
      {
        "id": "continue",
        "label": "聊聊下回怎样一起做",
        "line": "你们约好下次互相搭手，几天前的选择成了新的合作话题。",
        "bond": {
          "cook": {
            "trust": 0.5
          }
        },
        "setFlags": [
          "life-route:food:remembered"
        ]
      },
      {
        "id": "quiet",
        "label": "听完问候，继续自己的日子",
        "line": "你听完问候，回去做自己的事。那件事仍留在人们的记忆里。",
        "setFlags": [
          "life-route:food:remembered"
        ]
      }
    ]
  },
