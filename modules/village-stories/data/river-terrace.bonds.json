    },
    {
      "npc": "healer",
      "tier": "friend",
      "text": "蓍婆说：“你肯听，我就教你认三样草：止血的、退热的、要命的。最后一样最要紧。”",
      "reward": {
        "flags": [
          "healer-lesson"
        ]
      }
    },
    {
      "npc": "stonesmith",
      "tier": "acquaint",
      "text": "阿砺敲打着石料，忽然把一块边角料丢给你：“拿去刮鱼鳞。”"
    },
    {
      "npc": "stonesmith",
      "tier": "friend",
      "text": "阿砺第一次主动跟你说了很长一段话，讲他爹怎么在河湾找到第一块燧石。",
      "reward": {
        "items": [
          {
            "prototype": "prototype:stone-knife",
            "name": "阿砺打的石刀"
          }
        ]
      }
    },
    {
      "npc": "trader-elder",
      "tier": "friend",
      "text": "埴公拍着你的肩：“村里有什么解不开的疙瘩，你来找我。我这张老脸，还有人给面子。”"
    },
    {
      "npc": "yu",
      "tier": "friend",
      "text": "阿予把自家地头最肥的一垄指给你看：“等收了，分你一筐。”"
    },
    {
      "npc": "cook",
      "tier": "friend",
      "text": "阿灶往你碗里多扣了一勺：“别声张，就你有。”"
    },
    {
      "npc": "water-child",
      "tier": "friend",
      "text": "小汲神秘地告诉你，倒影里的村子也有一个你，“那个你比你爱笑”。"
    },
    {
      "npc": "elder-wife",
      "tier": "friend",
      "text": "陶婶往你手里塞了一块还热的粟饼：“我做多了，你拿着。”她当然没做多。"
    },
    {
      "npc": "yu-brother",
      "tier": "friend",
      "text": "阿石把一块画着红色花纹的陶片塞给你，扭头就走。那是他第一次把画给别人看。"
    },
    {
      "npc": "lan-mother",
      "tier": "friend",
      "text": "岚母把一张边上编了花的小席子递给你：“垫着坐，地上凉。”",
