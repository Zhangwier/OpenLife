  "dialogues": {
    "elder": {
      "start": "root",
      "nodes": {
        "root": {
          "text": "陶叔拨着窑灰，头也不抬：“有事？”",
          "options": [
            {
              "id": "fire",
              "label": "请教怎么看火",
              "next": "fire"
            },
            {
              "id": "master",
              "label": "问起他的师傅",
              "requires": {
                "quest": {
                  "main-2-kiln": "ask"
                }
              },
              "next": "master"
            },
            {
              "id": "heir",
              "label": "问他泥刀的事",
              "requires": {
                "minTier": "close"
              },
              "effects": {
                "bond": {
                  "trust": 0.5
                },
                "line": "陶叔拍拍你：“急什么。窑火认得你了，泥刀迟早是你的。”"
              }
            },
            {
              "id": "bye",
              "label": "不打扰了",
              "effects": {
                "line": "陶叔“嗯”了一声，又低头拨灰。"
              }
            }
          ]
        },
        "fire": {
          "text": "“火是活的。窑壁发白就是太急，发暗就是没吃饱。”他顿了顿，“你听得进去？”",
          "options": [
            {
              "id": "yes",
              "label": "认真记下",
              "effects": {
                "bond": {
                  "familiarity": 0.5,
                  "trust": 0.5
                },
                "line": "陶叔难得点了点头：“记性还行。”"
              }
            },
            {
              "id": "joke",
              "label": "开玩笑说火也挑人",
              "effects": {
                "bond": {
                  "familiarity": 0.5
                },
                "line": "陶叔哼了一声，嘴角却动了动：“挑人。挑的就是你这种嘴快的。”"
              }
            }
          ]
        },
        "master": {
          "text": "陶叔沉默了很久：“我师傅烧坏的罐子比烧成的多。他说，记住坏的，比记住好的有用。”",
          "options": [
            {
              "id": "listen",
              "label": "静静听完",
              "effects": {
                "setFlags": [
                  "elder-told-master"
                ],
                "bond": {
                  "trust": 1
                },
                "line": "陶叔把那块裂陶片又揣回怀里：“行了，你去挖土吧。”"
              }
            }
          ]
        }
      }
    },
    "lan": {
      "start": "root",
      "nodes": {
        "root": {
          "text": "阿岚正往背篓里塞东西：“我又要去渡口啦！你想听南岸的事吗？”",
          "options": [
            {
