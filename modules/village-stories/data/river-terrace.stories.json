  "note": "河岸台地的故事层：主线/支线任务链、NPC 对话树、节日仪式、限时活动、突发事件与成就。全部是数据，由 village-stories 模块解释执行；人物 key 与 settlement-locations 的居民一致。",
  "quests": [
    {
      "id": "main-1-arrival",
      "kind": "main",
      "chapter": 1,
      "title": "初到河岸",
      "giver": "trader-elder",
      "autoOffer": true,
      "summary": "埴公让你先认认人、出把力，村里才会把你当自己人。",
      "acceptLine": "埴公拄着棍子打量你：“来了就是缘分。先去跟大伙说说话，帮着干点活，日子自然就熟了。”",
      "steps": [
        {
          "id": "meet",
          "text": "和村里三个不同的人说上话",
          "objective": {
            "type": "distinctTalks",
            "count": 3
          }
        },
        {
          "id": "fuel-gather",
          "text": "去芦苇滩拾两回柴草",
          "objective": {
            "type": "counter",
            "counter": "gather:resource:fuel",
            "count": 2
          }
        },
        {
          "id": "fuel",
          "text": "给阿灶送一捆柴草",
          "objective": {
            "type": "deliver",
            "npc": "cook",
            "resource": "resource:fuel",
            "count": 1
          },
          "doneLine": "阿灶接过柴草往灶里一塞：“正好断火！埴公让你来的吧？这人情我记下了。”"
        }
      ],
      "reward": {
        "items": [
          {
            "prototype": "prototype:bowl",
            "name": "埴公送的陶碗"
          }
        ],
        "bond": {
          "trader-elder": {
            "familiarity": 1,
            "trust": 1
          },
          "cook": {
            "familiarity": 1
          }
        },
        "flags": [
          "settled-in"
        ]
      },
      "completeLine": "埴公把一只旧陶碗塞进你手里：“村里的规矩，人来了总得有只自己的碗。往后，你就是河岸的人了。”"
    },
    {
      "id": "main-2-kiln",
      "kind": "main",
      "chapter": 2,
      "title": "窑火传人",
      "giver": "elder",
      "requires": {
        "flags": [
          "settled-in"
        ]
      },
      "summary": "陶叔眼睛不比从前，想找个后生守窑。先学，再做，最后要让他亲眼看见你的手艺。",
      "acceptLine": "陶叔用拨火棍敲了敲窑壁：“想学看火？先学会等。急性子烧不出好东西。”",
      "steps": [
        {
          "id": "ask",
          "text": "听陶叔讲他师傅的事（对话）",
          "objective": {
            "type": "flag",
