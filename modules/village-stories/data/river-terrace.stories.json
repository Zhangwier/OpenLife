          }
        },
        {
          "id": "clay",
          "text": "去河湾挖两回黏土",
          "objective": {
            "type": "counter",
            "counter": "gather:resource:clay",
            "count": 2
          }
        },
        {
          "id": "make",
          "text": "亲手做成一件东西",
          "objective": {
            "type": "counter",
            "counter": "craft",
            "count": 1
          }
        },
        {
          "id": "show",
          "text": "把一只陶碗拿给陶叔看",
          "objective": {
            "type": "deliver",
            "npc": "elder",
            "resource": "resource:bowl",
            "count": 1
          },
          "doneLine": "陶叔把碗举到窑口的光里转了一圈，半天才说：“底子厚了点。不过——火候是对的。”"
        }
      ],
      "reward": {
        "items": [
          {
            "prototype": "prototype:sieve",
            "name": "陶叔的旧陶筛"
          }
        ],
        "bond": {
          "elder": {
            "familiarity": 1,
            "trust": 2
          },
          "clay-digger": {
            "familiarity": 1
          }
        },
        "flags": [
          "kiln-heir"
        ]
      },
      "completeLine": "陶叔把用了多年的陶筛交给你：“筛泥的活，往后归你了。”这是他第一次当着人夸一个后生。"
    },
    {
      "id": "main-3-ford",
