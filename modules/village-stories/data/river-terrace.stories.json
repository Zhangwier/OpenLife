            "type": "counter",
            "counter": "feast",
            "count": 1
          }
        },
        {
          "id": "gift",
          "text": "把一件器物托埴公带给南岸（陶罐或陶碗）",
          "objective": {
            "type": "deliver",
            "npc": "trader-elder",
            "resource": [
              "resource:jar",
              "resource:bowl"
