  "worksites": {
    "space:lodge-gear": {
      "label": "帮阿罟整理渔具",
      "hint": "把网坠、浮子、鱼篓分门别类挂上挂架；阿罟在场时算帮了他。",
      "helps": true
    },
    "space:herb-kitchen": {
      "label": "守着药灶看火",
      "hint": "药要文火慢煎，火大了药就苦焦；阿芷在场时算帮了她。",
      "helps": true
    }
  },
