  "residentLines": {
    "fisher": [
      "阿罟把晾网架上的网抖了抖：“网要晾透，湿着收起来，一冬就烂。”",
      "阿罟敲了敲蒲篷筏的篷顶：“有了这个，下雨也能在泽里待一夜。”"
    ],
    "herbalist": [
      "阿芷踮着脚在百格药柜前找药：“第三排第七格……你帮我记着点。”",
      "阿芷吹着药灶的火：“两眼灶，一眼煎药，一眼熬膏，谁也不耽误谁。”"
    ]
  }
}
