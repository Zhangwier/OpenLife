  "recipes": [
    {"id": "recipe:dried-fish", "name": "晾鱼干", "placeId": "place:yard", "spaceId": "space:drying-rack", "inputs": [{"prototypeId": "prototype:fish", "count": 1}], "tools": ["prototype:stone-knife"], "outputs": [{"prototypeId": "prototype:dried-fish", "count": 1}], "skill": "储食", "description": "剖开、去脏，挂在晾坯架下风干。鲜鱼放不过两天，鱼干能留到冬天。"},
    {"id": "recipe:millet-cake", "name": "烙粟饼", "placeId": "place:hearth-yard", "spaceId": "space:hearth", "inputs": [{"prototypeId": "prototype:grain", "count": 2}, {"prototypeId": "prototype:fuel-bundle", "count": 1}], "tools": [], "outputs": [{"prototypeId": "prototype:millet-cake", "count": 2}], "skill": "炊事", "description": "粟磨碎和水，贴在烧热的灶壁上烙干。比熟食耐放，适合带上远路。"},
    {"id": "recipe:spindle-whorl", "name": "烧陶纺轮", "placeId": "place:kiln", "spaceId": "space:kiln-mouth", "inputs": [{"prototypeId": "prototype:clay-batch", "count": 1}, {"prototypeId": "prototype:fuel-bundle", "count": 1}], "tools": [], "outputs": [{"prototypeId": "prototype:spindle-whorl", "count": 2}], "skill": "制陶", "description": "一团泥捏成两个扁圆饼，中间穿孔，随窑一起烧。纺线的人离不开它。"},
    {"id": "recipe:clay-xun", "name": "烧陶埙", "placeId": "place:kiln", "spaceId": "space:kiln-mouth", "inputs": [{"prototypeId": "prototype:clay-batch", "count": 1}, {"prototypeId": "prototype:fuel-bundle", "count": 1}], "tools": ["prototype:bone-needle"], "outputs": [{"prototypeId": "prototype:clay-xun", "count": 1}], "skill": "制陶", "description": "捏成中空的蛋形，用骨针钻出吹孔和音孔再入窑。吹得准不准，全看孔开得匀不匀。"},
    {"id": "recipe:bone-hook", "name": "磨骨鱼钩", "placeId": "place:river", "spaceId": "space:bank", "inputs": [{"prototypeId": "prototype:fish", "count": 1}], "tools": ["prototype:stone-knife"], "outputs": [{"prototypeId": "prototype:bone-hook", "count": 2}], "skill": "捕鱼", "description": "取大鱼的硬骨，在河边砂石上磨出倒刺。一条鱼的骨头能磨两枚钩。"},
    {"id": "recipe:hemp-cloth", "name": "纺麻织布", "placeId": "place:yard", "spaceId": "space:drying-rack", "inputs": [{"prototypeId": "prototype:fiber-bundle", "count": 2}], "tools": ["prototype:spindle-whorl"], "outputs": [{"prototypeId": "prototype:hemp-cloth", "count": 1}], "skill": "纺织", "description": "用陶纺轮把纤维捻成线，再在腰机上织成一小匹布。比纤维裹身结实得多。"},
    {"id": "recipe:reed-screen", "name": "编苇帘", "placeId": "place:reedbed", "spaceId": "space:reed-cut", "inputs": [{"prototypeId": "prototype:reed-bundle", "count": 2}, {"prototypeId": "prototype:rope", "count": 1}], "tools": [], "outputs": [{"prototypeId": "prototype:reed-screen", "count": 1}], "skill": "编织", "description": "苇秆排齐，用草绳一道道绞紧。挂在门口挡风，也能隔出一处寝处。"},
    {"id": "recipe:herb-bundle", "name": "扎药草", "placeId": "place:reedbed", "spaceId": "space:reed-cut", "inputs": [{"prototypeId": "prototype:fiber-bundle", "count": 1}], "tools": ["prototype:stone-knife"], "outputs": [{"prototypeId": "prototype:herb-bundle", "count": 1}], "skill": "采集", "description": "在滩边割下艾与蒿，用纤维扎成一束倒挂阴干。陶婶说伤口和受寒都用得上。"},
    {"id": "recipe:dugout", "name": "凿独木舟", "placeId": "place:ford", "spaceId": "space:ford-landing", "inputs": [{"prototypeId": "prototype:log", "count": 3}], "tools": ["prototype:stone-axe"], "outputs": [{"prototypeId": "prototype:dugout", "count": 1}], "skill": "木作", "description": "三段橡木拼成船身，烧一层、刮一层，再烧再刮，半个月才凿得空。做成的独木舟太重扛不走，就停在渡口岸边，能装六件东西。"},
    {"id": "recipe:big-urn", "name": "烧储粮大瓮", "placeId": "place:kiln", "spaceId": "space:kiln-mouth", "inputs": [{"prototypeId": "prototype:clay-batch", "count": 3}, {"prototypeId": "prototype:fuel-bundle", "count": 1}], "tools": [], "outputs": [{"prototypeId": "prototype:big-urn", "count": 1}], "skill": "制陶", "description": "泥条一圈圈盘到齐腰高，阴干十天再进窑。大瓮装得下十二份东西，烧成了就立在窑口，要几个人才抬得动。"},
    {"id": "recipe:loom", "name": "架立式织机", "placeId": "place:weaving-shed", "spaceId": "space:loom-room", "inputs": [{"prototypeId": "prototype:log", "count": 2}, {"prototypeId": "prototype:rope", "count": 1}], "tools": ["prototype:stone-axe"], "outputs": [{"prototypeId": "prototype:loom", "count": 1}], "skill": "木作", "description": "两根立柱、一根横梁、一排坠石，用草绳绑牢。织机立在织机间，织出来的布比腰机宽一倍。"},
    {"id": "recipe:mortar", "name": "掏木臼", "placeId": "place:longhouse", "spaceId": "space:longhouse-hall", "inputs": [{"prototypeId": "prototype:log", "count": 3}], "tools": ["prototype:stone-axe"], "outputs": [{"prototypeId": "prototype:mortar", "count": 1}], "skill": "木作", "description": "截一段粗木，用火和石斧一点点掏出臼窝。木臼舂粟、捣栗粉，一家人用上几十年。"},
    {"id": "recipe:totem-pole", "name": "立社木", "placeId": "place:shrine", "spaceId": "space:shrine-court", "inputs": [{"prototypeId": "prototype:log", "count": 3}, {"prototypeId": "prototype:rope", "count": 1}], "tools": [], "outputs": [{"prototypeId": "prototype:totem-pole", "count": 1}], "skill": "木作", "description": "三段橡木绑接成一根高柱，刻上各家的记号，立在祠前空场。社木立起来，村子就有了自己的来历。"},
    {"id": "recipe:smoking-rack", "name": "搭熏架", "placeId": "place:longhouse", "spaceId": "space:longhouse-hall", "inputs": [{"prototypeId": "prototype:log", "count": 2}, {"prototypeId": "prototype:rope", "count": 1}], "tools": [], "outputs": [{"prototypeId": "prototype:smoking-rack", "count": 1}], "skill": "木作", "description": "在火塘上方用木料和草绳搭一层格架，烟往上走，挂在上头的肉和鱼慢慢就熏干了。"},
    {"id": "recipe:stall-awning", "name": "搭摊棚", "placeId": "place:market", "spaceId": "space:market-row", "inputs": [{"prototypeId": "prototype:log", "count": 2}, {"prototypeId": "prototype:reed-bundle", "count": 2}], "tools": [], "outputs": [{"prototypeId": "prototype:stall-awning", "count": 1}], "skill": "木作", "description": "四根木料作柱、苇子铺顶，在摊位行搭一座遮雨的棚子。下雨天交换场也能照常开张。"},
    {"id": "recipe:stone-axe", "name": "磨石斧", "placeId": "place:stone-beach", "spaceId": "space:knapping-shed", "inputs": [{"prototypeId": "prototype:flint-stone", "count": 2}, {"prototypeId": "prototype:rope", "count": 1}], "tools": [], "outputs": [{"prototypeId": "prototype:stone-axe", "count": 1}], "skill": "打石", "description": "先把燧石敲出斧形，在砂岩上磨一整天磨出刃口，再用草绳绑上木柄。凿船、掏臼、伐木都离不开它。"},
    {"id": "recipe:snare", "name": "搓绳套", "placeId": "place:chestnut-wood", "spaceId": "space:wood-edge", "inputs": [{"prototypeId": "prototype:rope", "count": 2}], "tools": [], "outputs": [{"prototypeId": "prototype:snare", "count": 1}], "skill": "狩猎", "description": "两根草绳搓成一股，打一个会收紧的活结。下在兔子走惯的小道上，第二天去看。"},
    {"id": "recipe:bow", "name": "制木弓", "placeId": "place:chestnut-wood", "spaceId": "space:wood-edge", "inputs": [{"prototypeId": "prototype:log", "count": 1}, {"prototypeId": "prototype:fiber-bundle", "count": 2}], "tools": ["prototype:stone-knife"], "outputs": [{"prototypeId": "prototype:bow", "count": 1}], "skill": "狩猎", "description": "从木料里劈出一根有弹性的弓臂，削薄两头，用搓紧的麻纤维做弦。拉得开的人才射得中鹿。"},
    {"id": "recipe:hide", "name": "刮兽皮", "placeId": "place:longhouse", "spaceId": "space:longhouse-hall", "inputs": [{"prototypeId": "prototype:game", "count": 2}], "tools": ["prototype:stone-knife"], "outputs": [{"prototypeId": "prototype:hide", "count": 1}], "skill": "狩猎", "description": "剥下皮子、刮净油脂、绷在框上晾干，再用烟熏软。两只野兔的皮才凑得够一张。"},
    {"id": "recipe:hide-cloak", "name": "缝兽皮披", "placeId": "place:weaving-shed", "spaceId": "space:loom-room", "inputs": [{"prototypeId": "prototype:hide", "count": 2}], "tools": ["prototype:bone-needle"], "outputs": [{"prototypeId": "prototype:hide-cloak", "count": 1}], "skill": "纺织", "description": "两张兽皮对拼，用骨针和麻线缝成一件披风。冬天在河边站一整天也冻不透。"},
    {"id": "recipe:smoked-meat", "name": "熏肉", "placeId": "place:longhouse", "spaceId": "space:longhouse-hall", "inputs": [{"prototypeId": "prototype:game", "count": 1}, {"prototypeId": "prototype:fuel-bundle", "count": 1}], "tools": [], "outputs": [{"prototypeId": "prototype:smoked-meat", "count": 2}], "skill": "储食", "description": "野味切条、抹一层盐水，挂在火塘上方熏两天两夜。熏肉能放过一冬，带上远路也不坏。"},
