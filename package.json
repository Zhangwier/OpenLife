{
  "name": "openlife",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenLife - modular life simulation platform (Kernel Prototype)",
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "cli": "node apps/debug-console/main.ts",
    "demo": "node apps/debug-console/main.ts demo modern-world",
    "demo:magic": "node apps/debug-console/main.ts demo magic-test-world",
    "inspect": "node apps/debug-console/main.ts inspect",
    "web": "node apps/web/server.ts",
    "catalog": "node scripts/gen-module-catalog.ts",
    "catalog:check": "node scripts/gen-module-catalog.ts --check",
    "coverage": "node scripts/content-coverage.ts",
    "typecheck": "node scripts/typecheck.ts",
    "typecheck:update": "node scripts/typecheck.ts --update"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.6.3"
  }
}
